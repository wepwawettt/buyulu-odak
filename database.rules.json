{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.child('json').isString() && newData.child('json').val().length < 500000 && newData.child('at').isNumber()"
      }
    },
    "profiles": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.child('name').isString() && newData.child('name').val().length <= 16 && newData.child('cls').isString() && newData.child('cls').val().length <= 16 && newData.child('week').isString() && newData.child('week').val().length <= 10 && newData.child('min').isNumber()"
      }
    },
    "codes": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && !data.exists() && newData.val() === auth.uid && $code.length <= 12"
      }
    },
    "invites": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$from": {
          ".write": "auth != null && (auth.uid === $from || auth.uid === $uid)",
          ".validate": "newData.isBoolean()"
        }
      }
    },
    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && data.child('host').val() === auth.uid",
        "host": {
          ".write": "auth != null && ((!data.exists() && newData.val() === auth.uid) || data.val() === auth.uid)"
        },
        "members": {
          "$uid": {
            ".write": "auth != null && ($uid === auth.uid || root.child('rooms').child($code).child('host').val() === auth.uid)"
          }
        },
        "pos": {
          "$uid": {
            ".write": "auth != null && $uid === auth.uid"
          }
        },
        "requests": {
          "$uid": {
            ".write": "auth != null && ($uid === auth.uid || root.child('rooms').child($code).child('host').val() === auth.uid)"
          }
        },
        "rejects": {
          "$uid": {
            ".write": "auth != null && ($uid === auth.uid || root.child('rooms').child($code).child('host').val() === auth.uid)"
          }
        },
        "timer": {
          ".write": "auth != null && root.child('rooms').child($code).child('host').val() === auth.uid"
        },
        "chat": {
          "$msg": {
            ".write": "auth != null && !data.exists() && root.child('rooms').child($code).child('members').child(auth.uid).exists()",
            ".validate": "newData.child('uid').val() === auth.uid && newData.child('text').isString() && newData.child('text').val().length <= 200"
          }
        }
      }
    }
  }
}
