{
  "rules": {
    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && data.child('host').val() === auth.uid",
        "host": {
          ".write": "auth != null && ((!data.exists() && newData.val() === auth.uid) || data.val() === auth.uid)"
        },
        "members": {
          "$uid": {
            ".write": "auth != null && ($uid === auth.uid || root.child('rooms').child($code).child('host').val() === auth.uid)"
          }
        },
        "pos": {
          "$uid": {
            ".write": "auth != null && $uid === auth.uid"
          }
        },
        "requests": {
          "$uid": {
            ".write": "auth != null && ($uid === auth.uid || root.child('rooms').child($code).child('host').val() === auth.uid)"
          }
        },
        "rejects": {
          "$uid": {
            ".write": "auth != null && ($uid === auth.uid || root.child('rooms').child($code).child('host').val() === auth.uid)"
          }
        },
        "timer": {
          ".write": "auth != null && root.child('rooms').child($code).child('host').val() === auth.uid"
        },
        "chat": {
          "$msg": {
            ".write": "auth != null && !data.exists() && root.child('rooms').child($code).child('members').child(auth.uid).exists()",
            ".validate": "newData.child('uid').val() === auth.uid && newData.child('text').isString() && newData.child('text').val().length <= 200"
          }
        }
      }
    }
  }
}
